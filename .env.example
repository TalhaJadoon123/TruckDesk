# =============================================================================
# TruckDesk environment
#
# EVERY value below has a working default, so `pnpm dev` runs with this file
# untouched and nothing on it costs money. Copy it, then fill in only the keys you
# actually need - the /capabilities endpoint tells you which are active.
#
# Zero-cost setup order:
#   1. GROQ_API_KEY     free, 30 seconds          - broker email parsing
#   2. DATABASE_URL     free tier, 5 minutes       - persist data
#   3. AUTH_SECRET      generate with one command - sessions and tokens
# Everything else is optional.
# =============================================================================

# ------------------------------------------------------------------ required --
# Signs API tokens and session cookies. MUST be 16+ characters.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
API_TOKEN_SECRET=

# --------------------------------------------------------------------- server --
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Comma-separated. Localhost defaults are used when unset.
# CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ------------------------------------------------------------------- database --
# Pick ONE. Both free tiers are fine; nothing here costs money.
#
# Neon (recommended - no connection pooling to configure):
#   1. console.neon.tech -> Create project (Free) -> Connection string
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/truckdesk?sslmode=require
#
# Supabase (also gives you Realtime tracking and Storage for BOL/POD photos):
#   1. supabase.com -> New project (Free)
#   2. Settings -> Database -> Connection string -> URI (port 5432)
#      DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#   3. If you use the pooler on 6543, set DATABASE_PREPARE=false
#
# Local Docker Postgres (no signup at all):
#   DATABASE_URL=postgresql://truckdesk:truckdesk@localhost:5432/truckdesk
DATABASE_URL=
DATABASE_POOL_MAX=10
# Must be false for Supabase's transaction-mode pooler (port 6543).
DATABASE_PREPARE=true

# ----------------------------------------- Supabase Realtime + Storage (free) --
# Only needed for live map updates and photo uploads. The app works without it:
# tracking falls back to polling and documents upload as metadata only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=load-documents

# ----------------------------------------------------------------- LLM (free) --
# console.groq.com/keys -> Create key (free, no card).
# ~14k-30k requests/day is enough for a small carrier parsing broker emails.
# Without it, parsing falls back to a deterministic regex parser - still works,
# just reads fewer fields.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_MS=20000

# ------------------------------------------------- notifications (push, free) --
# Expo push needs no token on the free tier. Add one only if you hit limits.
EXPO_ACCESS_TOKEN=

# Twilio SMS. OFF by default on purpose - see packages/sms for why.
# Free trial is $15 of credit (about 5,000 US messages), and a dispatcher loop
# can spend that overnight. Push carries every driver notification instead.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# ------------------------------------------------------------------- email ----
# Cloudflare Email Workers (free 100/day) or any HTTP mail endpoint.
# Only used for password-reset links and invoice delivery.
EMAIL_WORKER_URL=
EMAIL_FROM=TruckDesk <no-reply@truckdesk.app>

# ---------------------------------------------------------------- payments ----
# Polar (open-source LemonSqueezy alternative) or LemonSqueezy.
# Both have a free tier. Neither is required for the app to run.
PAYMENTS_PROVIDER=polar
POLAR_API_KEY=
POLAR_WEBHOOK_SECRET=

# ------------------------------------------------------------------ ELD -------
# Optional. The built-in simulator reads duty status from the driver app, so
# neither of these is needed unless you already pay for an ELD subscription.
SAMSARA_TOKEN=
MOTIVE_ACCESS_TOKEN=

# ----------------------------------------------------------------- web tier ---
# Where the Next.js app should send API calls.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Development fallback identity when no database is present. Ignored in production.
DEV_COMPANY_ID=co_ridgeway
DEV_USER_ID=us_seed_owner

# ------------------------------------------------------------------- upload --
MAX_UPLOAD_BYTES=12582912

# ------------------------------------------------------- development flags --
# Comma-separated user ids allowed to act as an admin. Ignored in production.
DEV_ADMIN_IDS=
# Allows the destructive/seed endpoints. Keep false outside development.
ALLOW_SEED=false
# The seeded demo account. Only used by `pnpm seed` when writing the owner row.
DEMO_EMAIL=dispatcher@ridgewayfreight.com
DEMO_PASSWORD=truckdesk-demo

# =============================================================================
# Cloudflare Worker (packages/api/wrangler.toml)
# Set these with `wrangler secret put NAME`, not here:
#   GROQ_API_KEY, API_TOKEN
# Vars live in wrangler.toml:
#   API_ORIGIN   the Node API that owns Postgres (Fly/Railway/Docker)
#   CORS_ORIGINS your Pages + domain origins
# =============================================================================