{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "lib":  [
                                        "ES2023",
                                        "DOM",
                                        "DOM.Iterable"
                                    ],
                            "module":  "ES2022",
                            "moduleResolution":  "Bundler",
                            "strict":  true,
                            "outDir":  "dist-ui",
                            "rootDir":  "src/ui",
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "declaration":  false,
                            "sourceMap":  false
                        },
    "include":  [
                    "src/ui/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "dist",
                    "dist-ui",
                    "release",
                    "src/main"
                ]
}
