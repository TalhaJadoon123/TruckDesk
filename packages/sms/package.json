{
  "name": "@truckdesk/sms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Notification delivery for TruckDesk: push (Expo, free) primary, Twilio SMS on free trial credit",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@truckdesk/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}